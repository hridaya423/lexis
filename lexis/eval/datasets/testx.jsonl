{"id": "t-w011", "os": "windows", "platform": "windows", "intent": "kill the Run key entry for Spotify", "gold": "Remove-ItemProperty -Path \"HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run\" -Name \"Spotify\"", "expect": {"anyOfRegex": ["^\\s*Remove\\-ItemProperty\\s+\\-Path\\s+\"HKCU:\\\\SOFTWARE\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Run\"\\s+\\-Name\\s+\"Spotify\"\\s*$"], "maxCommands": 1}}
{"id": "t-w012", "os": "windows", "platform": "windows", "intent": "point Wi-Fi at dns server \"9.9.9.9\"", "gold": "Set-DnsClientServerAddress -InterfaceAlias \"Wi-Fi\" -ServerAddresses \"9.9.9.9\"", "expect": {"anyOfRegex": ["^\\s*Set\\-DnsClientServerAddress\\s+\\-InterfaceAlias\\s+\"Wi\\-Fi\"\\s+\\-ServerAddresses\\s+\"9\\.9\\.9\\.9\"\\s*$"], "maxCommands": 1}}
{"id": "t-w013", "os": "windows", "platform": "windows", "intent": "grab the *.mp4 files in ~\\Downloads and copy to E:\\Media", "gold": "robocopy \"~\\Downloads\" \"E:\\Media\" \"*.mp4\"", "expect": {"anyOfRegex": ["^\\s*robocopy\\s+\"\\~\\\\Downloads\"\\s+\"E:\\\\Media\"\\s+\"\\*\\.mp4\"\\s*$"], "maxCommands": 1}}
{"id": "t-w014", "os": "windows", "platform": "windows", "intent": "number of apps under the Uninstall key", "gold": "(Get-ChildItem \"HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\").Count", "expect": {"anyOfRegex": ["^\\s*\\(Get\\-ChildItem\\s+\"HKLM:\\\\SOFTWARE\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Uninstall\"\\)\\.Count\\s*$"], "maxCommands": 1}}
{"id": "t-w015", "os": "windows", "platform": "windows", "intent": "robocopy ~\\Downloads to E:\\Media filtered to *.mp4", "gold": "robocopy \"~\\Downloads\" \"E:\\Media\" \"*.mp4\"", "expect": {"anyOfRegex": ["^\\s*robocopy\\s+\"\\~\\\\Downloads\"\\s+\"E:\\\\Media\"\\s+\"\\*\\.mp4\"\\s*$"], "maxCommands": 1}}
{"id": "t-w016", "os": "windows", "platform": "windows", "intent": "list C:\\Users\\alex\\Documents, save the full list to .\\dirlist.txt but only show the first 10", "gold": "Get-ChildItem \"C:\\Users\\alex\\Documents\" | Tee-Object -FilePath \".\\dirlist.txt\" | Select-Object -First 10", "expect": {"anyOfRegex": ["^\\s*Get\\-ChildItem\\s+\"C:\\\\Users\\\\alex\\\\Documents\"\\s+\\|\\s+Tee\\-Object\\s+\\-FilePath\\s+\"\\.\\\\dirlist\\.txt\"\\s+\\|\\s+Select\\-Object\\s+\\-First\\s+10\\s*$"], "maxCommands": 1}}
{"id": "t-w017", "os": "windows", "platform": "windows", "intent": "count the uninstall registry entries", "gold": "(Get-ChildItem \"HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\").Count", "expect": {"anyOfRegex": ["^\\s*\\(Get\\-ChildItem\\s+\"HKLM:\\\\SOFTWARE\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Uninstall\"\\)\\.Count\\s*$"], "maxCommands": 1}}
{"id": "t-w018", "os": "windows", "platform": "windows", "intent": "disable Spotify auto-start via the registry", "gold": "Remove-ItemProperty -Path \"HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run\" -Name \"Spotify\"", "expect": {"anyOfRegex": ["^\\s*Remove\\-ItemProperty\\s+\\-Path\\s+\"HKCU:\\\\SOFTWARE\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Run\"\\s+\\-Name\\s+\"Spotify\"\\s*$"], "maxCommands": 1}}
{"id": "t-w019", "os": "windows", "platform": "windows", "intent": "check the hosts file for devbox", "gold": "Get-Content C:\\Windows\\System32\\drivers\\etc\\hosts | Select-String \"devbox\"", "expect": {"anyOfRegex": ["^\\s*Get\\-Content\\s+C:\\\\Windows\\\\System32\\\\drivers\\\\etc\\\\hosts\\s+\\|\\s+Select\\-String\\s+\"devbox\"\\s*$"], "maxCommands": 1}}
{"id": "t-w020", "os": "windows", "platform": "windows", "intent": "use \"9.9.9.9\" for dns on Wi-Fi", "gold": "Set-DnsClientServerAddress -InterfaceAlias \"Wi-Fi\" -ServerAddresses \"9.9.9.9\"", "expect": {"anyOfRegex": ["^\\s*Set\\-DnsClientServerAddress\\s+\\-InterfaceAlias\\s+\"Wi\\-Fi\"\\s+\\-ServerAddresses\\s+\"9\\.9\\.9\\.9\"\\s*$"], "maxCommands": 1}}
{"id": "t-w021", "os": "windows", "platform": "windows", "intent": "find hosts entries mentioning devbox", "gold": "Get-Content C:\\Windows\\System32\\drivers\\etc\\hosts | Select-String \"devbox\"", "expect": {"anyOfRegex": ["^\\s*Get\\-Content\\s+C:\\\\Windows\\\\System32\\\\drivers\\\\etc\\\\hosts\\s+\\|\\s+Select\\-String\\s+\"devbox\"\\s*$"], "maxCommands": 1}}
{"id": "t-w022", "os": "windows", "platform": "windows", "intent": "make a codesigning cert named myapp.local", "gold": "New-SelfSignedCertificate -DnsName \"myapp.local\" -CertStoreLocation Cert:\\CurrentUser\\My -Type CodeSigningCert", "expect": {"anyOfRegex": ["^\\s*New\\-SelfSignedCertificate\\s+\\-DnsName\\s+\"myapp\\.local\"\\s+\\-CertStoreLocation\\s+Cert:\\\\CurrentUser\\\\My\\s+\\-Type\\s+CodeSigningCert\\s*$"], "maxCommands": 1}}
{"id": "t-w023", "os": "windows", "platform": "windows", "intent": "pull machine scope DOTNET_ROOT", "gold": "[Environment]::GetEnvironmentVariable(\"DOTNET_ROOT\",\"Machine\")", "expect": {"anyOfRegex": ["^\\s*\\[Environment\\]::GetEnvironmentVariable\\(\"DOTNET_ROOT\",\"Machine\"\\)\\s*$"], "maxCommands": 1}}
{"id": "t-w024", "os": "windows", "platform": "windows", "intent": "give me the 10 heaviest cpu consumers", "gold": "Get-Process | Sort-Object CPU -Descending | Select-Object -First 10", "expect": {"anyOfRegex": ["^\\s*Get\\-Process\\s+\\|\\s+Sort\\-Object\\s+CPU\\s+\\-Descending\\s+\\|\\s+Select\\-Object\\s+\\-First\\s+10\\s*$"], "maxCommands": 1}}
